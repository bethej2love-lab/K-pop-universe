on:
  workflow_dispatch:

jobs:
  setpw:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: set admin password
        env:
          SUPABASE_SERVICE_ROLE: ${{ secrets.SUPABASE_SERVICE_ROLE }}
          NEW_PASSWORD: ${{ secrets.KPU_ADMIN_PASSWORD }}
          ADMIN_EMAIL: ${{ secrets.KPU_ADMIN_EMAIL }}
        run: node tools/set_admin_password.mjs
