  "sourceAgeFunction": "function _mxAgeAt(bday,debut){\n  const re=/(\\d{4})\\D?(\\d{1,2})?\\D?(\\d{1,2})?/;\n  const b=String(bday||'').match(re),d=String(debut||'').match(re);\n  if(!b||!d)return null;\n  const tb=Date.UTC(+b[1],(+b[2]||7)-1,+b[3]||1),td=Date.UTC(+d[1],(+d[2]||7)-1,+d[3]||1);\n  return{age:(td-tb)/(365.2425*864e5),year:+d[1]+((+d[2]||7)-1)/12+((+d[3]||1)-1)/365};\n}",
